{
  "name": "viiversion-demo-studio",
  "version": "0.14.0",
  "private": true,
  "description": "AI-directed presentation-video generation for web applications",
  "type": "module",
  "scripts": {
    "serve": "tsx src/server-cli.ts",
    "start": "node dist/server-cli.js",
    "build": "tsc",
    "direct": "tsx src/director-cli.ts",
    "capture": "tsx src/cli.ts",
    "render": "tsx src/render-cli.ts",
    "ux-audit": "tsx src/ux-design-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "deploy:cloudflare": "wrangler deploy",
    "voice": "tsx src/voice-engine-cli.ts",
    "voice:cast": "tsx src/voice-cast-cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "playwright": "1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.136.0"
  },
  "engines": {
    "node": ">=20"
  }
}
