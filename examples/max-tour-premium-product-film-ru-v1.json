{
  "name": "MAX TOUR — Premium Russian Product Film v1",
  "baseUrl": "https://max-tour.viiversion.com",
  "viewport": {
    "width": 430,
    "height": 932
  },
  "defaultPauseMs": 220,
  "presentation": {
    "semanticCamera": {
      "enabled": true,
      "establishScale": 1,
      "focusScale": 1.1,
      "mobileFocusScale": 1.1,
      "maxCropRatio": 0.12,
      "safeAreaPx": 44,
      "focusTransitionMs": 240,
      "resolveTransitionMs": 300
    },
    "smartZoom": {
      "enabled": false
    },
    "cursor": {
      "enabled": false
    },
    "focusRing": {
      "enabled": true,
      "color": "rgba(255,166,92,0.28)",
      "width": 1,
      "padding": 5
    },
    "clickRipple": {
      "enabled": false
    },
    "tactilePress": {
      "enabled": true,
      "scale": 0.985,
      "durationMs": 190,
      "glowColor": "rgba(255,151,72,0.30)"
    }
  },
  "steps": [
    {
      "action": "goto",
      "url": "/",
      "label": "Home"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "role",
        "value": "button",
        "name": "RU",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 20000,
      "label": "Wait RU"
    },
    {
      "action": "click",
      "target": {
        "by": "role",
        "value": "button",
        "name": "RU",
        "exact": true
      },
      "pauseAfterMs": 500,
      "label": "Switch to Russian"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Выбрать тур",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 20000,
      "label": "Wait home hero"
    },
    {
      "action": "wait",
      "ms": 1200,
      "label": "Establish home"
    },
    {
      "action": "hover",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Выбрать тур",
        "exact": true
      },
      "pauseAfterMs": 850,
      "label": "Focus choose tour"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button.nav-btn:has-text(\"Каталог\"):visible"
      },
      "label": "Open catalog"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "input[placeholder=\"Поиск: Далат, море, Ханой...\"]:visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait catalog"
    },
    {
      "action": "wait",
      "ms": 900,
      "label": "Establish catalog"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "input[placeholder=\"Поиск: Далат, море, Ханой...\"]:visible"
      },
      "value": "Далат",
      "pauseAfterMs": 350,
      "label": "Search Dalat"
    },
    {
      "action": "click",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Показать",
        "exact": true
      },
      "pauseAfterMs": 700,
      "label": "Apply catalog search"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "article.tour-card"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait Dalat results"
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "article.tour-card"
      },
      "pauseAfterMs": 850,
      "label": "Focus Dalat Premium"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "article.tour-card"
      },
      "pauseAfterMs": 600,
      "label": "Open Dalat Premium"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Присоединиться\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait tour"
    },
    {
      "action": "wait",
      "ms": 1200,
      "label": "Establish tour"
    },
    {
      "action": "scroll",
      "y": 620,
      "label": "Explore tour details",
      "pauseAfterMs": 400
    },
    {
      "action": "wait",
      "ms": 1300,
      "label": "Read tour details"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button.nav-btn:has-text(\"ИИ-Помощник\"):visible"
      },
      "label": "Open AI consultant"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "textarea[placeholder=\"Напишите сообщение...\"]:visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait AI input"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "textarea[placeholder=\"Напишите сообщение...\"]:visible"
      },
      "value": "Мы живём в Нячанге и хотим красивую экскурсию без слишком тяжёлой нагрузки. Подойдёт ли нам Далат «Премиум»?",
      "pauseAfterMs": 650,
      "label": "Ask a human excursion question"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"→\"):visible >> nth=-1"
      },
      "label": "Send AI question",
      "pauseAfterMs": 0
    },
    {
      "action": "waitForContentGrowth",
      "target": {
        "by": "css",
        "value": "body"
      },
      "minAddedChars": 80,
      "timeoutMs": 15000,
      "label": "Wait for actual AI answer"
    },
    {
      "action": "wait",
      "ms": 1800,
      "label": "Read AI answer"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button.nav-btn:has-text(\"Каталог\"):visible"
      },
      "pauseAfterMs": 450,
      "label": "Close AI consultant"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "input[placeholder=\"Поиск: Далат, море, Ханой...\"]:visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Return to catalog"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "input[placeholder=\"Поиск: Далат, море, Ханой...\"]:visible"
      },
      "value": "Далат",
      "pauseAfterMs": 250,
      "label": "Search Dalat again"
    },
    {
      "action": "click",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Показать",
        "exact": true
      },
      "pauseAfterMs": 650,
      "label": "Apply Dalat search again"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "article.tour-card"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait Dalat again"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "article.tour-card"
      },
      "pauseAfterMs": 550,
      "label": "Return to Dalat"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Присоединиться\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Return to tour"
    },
    {
      "action": "scroll",
      "y": 2200,
      "label": "Scroll to departures",
      "pauseAfterMs": 450
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Присоединиться\"):visible >> nth=0"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait booking CTA"
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Присоединиться\"):visible >> nth=0"
      },
      "pauseAfterMs": 650,
      "label": "Focus booking CTA"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Присоединиться\"):visible >> nth=0"
      },
      "label": "Start booking"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Перейти к оплате",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait booking"
    },
    {
      "action": "wait",
      "ms": 900,
      "label": "Establish booking"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "input[placeholder=\"Например: Sunrise\"]:visible"
      },
      "value": "Amiana Resort",
      "label": "Enter hotel"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "input[placeholder=\"Фамилия Имя\"]:visible >> nth=0"
      },
      "value": "Анна Смирнова",
      "label": "Traveller one name"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "input[type=\"date\"]:visible >> nth=1"
      },
      "value": "1992-05-12",
      "label": "Traveller one birth date"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "input[placeholder=\"Фамилия Имя\"]:visible >> nth=1"
      },
      "value": "Илья Смирнов",
      "label": "Traveller two name"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "input[type=\"date\"]:visible >> nth=2"
      },
      "value": "1990-10-03",
      "label": "Traveller two birth date"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "input[placeholder=\"Фамилия Имя\"]:visible >> nth=2"
      },
      "value": "Маша Смирнова",
      "label": "Traveller child name"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "input[type=\"date\"]:visible >> nth=3"
      },
      "value": "2015-06-14",
      "label": "Traveller child birth date"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"VNPAY\"):visible"
      },
      "pauseAfterMs": 450,
      "label": "Choose VNPAY"
    },
    {
      "action": "wait",
      "ms": 900,
      "label": "Show quote"
    }
  ]
}
