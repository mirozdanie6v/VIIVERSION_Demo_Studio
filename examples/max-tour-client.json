{
  "name": "MAX TOUR client presentation",
  "baseUrl": "https://max-tour.viiversion.com",
  "viewport": {
    "width": 430,
    "height": 932
  },
  "defaultPauseMs": 750,
  "presentation": {
    "smartZoom": {
      "scale": 1.1,
      "mobileScale": 1.035,
      "transitionMs": 300,
      "settleMs": 120
    },
    "focusRing": {
      "enabled": true
    },
    "clickRipple": {
      "enabled": true
    }
  },
  "steps": [
    {
      "action": "goto",
      "url": "/",
      "label": "MAX TOUR mobile experience",
      "narration": "MAX TOUR — мобильное приложение для путешествий по Вьетнаму."
    },
    {
      "action": "waitFor",
      "target": {
        "by": "text",
        "value": "Ваш лучший отдых",
        "exact": false
      },
      "state": "visible",
      "timeoutMs": 20000
    },
    {
      "action": "wait",
      "ms": 1100,
      "label": "Show the home screen",
      "narration": "Все направления и основные сервисы собраны на одном экране."
    },
    {
      "action": "click",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Выбрать тур",
        "exact": true
      },
      "label": "Open catalog",
      "narration": "Каталог открывается одним нажатием."
    },
    {
      "action": "waitFor",
      "target": {
        "by": "text",
        "value": "17 найдено",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "scroll",
      "y": 420,
      "label": "Browse live catalog",
      "narration": "Фильтры, цены и формат поездки видны сразу.",
      "pauseAfterMs": 850
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "h3:has-text(\"Далат «Премиум»\"):visible"
      },
      "label": "Open Dalat Premium",
      "narration": "Открываем Далат Премиум."
    },
    {
      "action": "wait",
      "ms": 1300
    },
    {
      "action": "scroll",
      "y": 500,
      "label": "Explore tour details",
      "narration": "В карточке — маршрут, тарифы, фотографии и правила поездки.",
      "pauseAfterMs": 900
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Индивидуальный\"):visible"
      },
      "label": "Choose private tour",
      "narration": "Клиент выбирает формат и переходит к оформлению."
    },
    {
      "action": "wait",
      "ms": 1400
    },
    {
      "action": "scroll",
      "y": 420,
      "label": "Booking flow",
      "narration": "Дальше — дата, участники, трансфер и данные для бронирования.",
      "pauseAfterMs": 900
    },
    {
      "action": "click",
      "target": {
        "by": "role",
        "value": "button",
        "name": "ИИ-Помощник",
        "exact": true
      },
      "label": "Open AI assistant",
      "narration": "AI-помощник помогает подобрать подходящий вариант."
    },
    {
      "action": "wait",
      "ms": 1500
    }
  ]
}
