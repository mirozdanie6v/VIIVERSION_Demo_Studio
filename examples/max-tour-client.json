{
  "name": "MAX TOUR client presentation",
  "baseUrl": "https://max-tour.viiversion.com",
  "viewport": {
    "width": 430,
    "height": 932
  },
  "defaultPauseMs": 900,
  "presentation": {
    "smartZoom": {
      "scale": 1.1,
      "mobileScale": 1.035,
      "transitionMs": 300,
      "settleMs": 120
    },
    "focusRing": {
      "enabled": true
    },
    "clickRipple": {
      "enabled": true
    }
  },
  "steps": [
    {
      "action": "goto",
      "url": "/",
      "label": "MAX TOUR mobile experience",
      "narration": "MAX TOUR — мобильное приложение, где клиент проходит весь путь от выбора экскурсии до бронирования."
    },
    {
      "action": "waitFor",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Выбрать путешествие",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 20000
    },
    {
      "action": "click",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Выбрать путешествие",
        "exact": true
      },
      "label": "Open tour catalog",
      "narration": "Из главного экрана клиент сразу открывает каталог актуальных маршрутов."
    },
    {
      "action": "waitFor",
      "target": {
        "by": "role",
        "value": "heading",
        "name": "Куда поедем?",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 20000
    },
    {
      "action": "scroll",
      "y": 520,
      "label": "Browse catalog",
      "narration": "Каталог показывает направления, фотографии, стоимость и помогает быстро выбрать подходящий вариант.",
      "pauseAfterMs": 1100
    },
    {
      "action": "goto",
      "url": "/tour/dalat-premium",
      "label": "Open tour details",
      "narration": "Карточка экскурсии объединяет программу, фотографии, условия, включённые услуги и цену."
    },
    {
      "action": "waitFor",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Выбрать формат",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 20000
    },
    {
      "action": "scroll",
      "y": 620,
      "label": "Tour content",
      "narration": "Клиент изучает маршрут внутри одного интерфейса и переходит к оформлению.",
      "pauseAfterMs": 900
    },
    {
      "action": "click",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Выбрать формат",
        "exact": true
      },
      "label": "Start booking",
      "narration": "Бронирование начинается прямо из карточки тура."
    },
    {
      "action": "waitFor",
      "target": {
        "by": "role",
        "value": "heading",
        "name": "Бронирование экскурсии",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 20000
    },
    {
      "action": "click",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Продолжить индивидуально",
        "exact": true
      },
      "label": "Choose private format",
      "narration": "Клиент выбирает формат, состав группы, дату, трансфер и вариант оплаты."
    },
    {
      "action": "waitFor",
      "target": {
        "by": "role",
        "value": "heading",
        "name": "Кто едет?",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "click",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Выбрать дату",
        "exact": true
      },
      "label": "Continue to date",
      "narration": "Каждый следующий шаг остаётся понятным и мобильным."
    },
    {
      "action": "waitFor",
      "target": {
        "by": "role",
        "value": "heading",
        "name": "Когда едем?",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "wait",
      "ms": 1200
    },
    {
      "action": "goto",
      "url": "/manager",
      "label": "Manager workspace",
      "narration": "Для команды заявки продолжаются в рабочем интерфейсе менеджера: заказы, клиенты и подтверждения."
    },
    {
      "action": "waitFor",
      "target": {
        "by": "role",
        "value": "heading",
        "name": "Заказы",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 20000
    },
    {
      "action": "scroll",
      "y": 420,
      "pauseAfterMs": 1000
    },
    {
      "action": "goto",
      "url": "/owner",
      "label": "Owner dashboard",
      "narration": "Владелец видит показатели и работу команды в той же системе."
    },
    {
      "action": "waitFor",
      "target": {
        "by": "role",
        "value": "heading",
        "name": "Панель владельца",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 20000
    },
    {
      "action": "wait",
      "ms": 1600
    }
  ]
}
