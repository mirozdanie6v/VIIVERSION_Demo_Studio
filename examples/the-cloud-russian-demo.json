{
  "name": "The Cloud — Russian Mini App Demo",
  "baseUrl": "https://thecloud.viiversion.com",
  "viewport": {
    "width": 430,
    "height": 932
  },
  "defaultPauseMs": 620,
  "presentation": {
    "smartZoom": {
      "scale": 1.1,
      "mobileScale": 1.06,
      "transitionMs": 520,
      "settleMs": 220
    },
    "cursor": {
      "size": 15,
      "fill": "rgba(255,255,255,0.96)",
      "border": "rgba(20,24,28,0.70)",
      "borderWidth": 2,
      "shadow": "0 5px 18px rgba(0,0,0,0.22)"
    },
    "focusRing": {
      "enabled": true,
      "color": "rgba(255,255,255,0.34)",
      "width": 2,
      "padding": 8
    },
    "clickRipple": {
      "enabled": true,
      "color": "rgba(255,255,255,0.42)",
      "size": 50,
      "durationMs": 380
    }
  },
  "steps": [
    {
      "action": "goto",
      "url": "/",
      "label": "Открыть The Cloud"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "text",
        "value": "Вечерний rooftop-бар с кальяном, коктейлями, видом на город и позициями для разного настроения.",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 20000
    },
    {
      "action": "hover",
      "target": {
        "by": "text",
        "value": "Вечерний rooftop-бар с кальяном, коктейлями, видом на город и позициями для разного настроения.",
        "exact": true
      },
      "pauseAfterMs": 8500,
      "narration": "The Cloud — rooftop-бар в Нячанге. В мини-приложении собраны атмосфера заведения, бронирование, AI-консультант, контакты и локация."
    },
    {
      "action": "click",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Позиции",
        "exact": true
      },
      "label": "Открыть позиции"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "text",
        "value": "Выберите атмосферу вечера.",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "hover",
      "target": {
        "by": "text",
        "value": "Sunset Line",
        "exact": true
      },
      "pauseAfterMs": 9000,
      "narration": "Гость выбирает атмосферу вечера: панорамный вид, закат, кальянный лаунж, активную зону у бара или приватный Group VIP."
    },
    {
      "action": "click",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Бронировать",
        "exact": true
      },
      "label": "Перейти к бронированию"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "text",
        "value": "1. Детали",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "hover",
      "target": {
        "by": "text",
        "value": "5. Оплата",
        "exact": true
      },
      "pauseAfterMs": 8500,
      "narration": "Бронирование разбито на пять шагов: детали визита, позиция, стол, контактные данные и оплата. Весь путь до подтверждения виден сразу."
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "input[type=\"time\"]"
      },
      "value": "18:30",
      "label": "Выбрать время"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "input[type=\"number\"]"
      },
      "value": "2",
      "label": "Указать гостей"
    },
    {
      "action": "hover",
      "target": {
        "by": "text",
        "value": "Дата",
        "exact": true
      },
      "pauseAfterMs": 6500,
      "narration": "Сначала выбираем дату, время и число гостей. Для примера — столик на двоих к закату."
    },
    {
      "action": "click",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Далее",
        "exact": true
      },
      "label": "Продолжить бронирование"
    },
    {
      "action": "wait",
      "ms": 1800
    },
    {
      "action": "hover",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Rooftop View",
        "exact": false
      },
      "pauseAfterMs": 7500,
      "narration": "На следующем шаге выбирается нужная зона. Контекст бронирования сохраняется, поэтому гость понимает, что именно резервирует."
    },
    {
      "action": "click",
      "target": {
        "by": "role",
        "value": "button",
        "name": "AI",
        "exact": true
      },
      "label": "Открыть AI-консультанта"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "text",
        "value": "AI-консультант",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "hover",
      "target": {
        "by": "text",
        "value": "Где лучше на закат?",
        "exact": true
      },
      "pauseAfterMs": 6500,
      "narration": "AI-консультант помогает выбрать место по ситуации: красивый вид, кальян, компания или лучший стол на закат."
    },
    {
      "action": "click",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Где лучше на закат?",
        "exact": true
      },
      "label": "Спросить AI про закат"
    },
    {
      "action": "wait",
      "ms": 7500,
      "narration": "Консультант отвечает внутри приложения и учитывает контекст The Cloud. Переходить в отдельный чат не нужно."
    },
    {
      "action": "click",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Главная",
        "exact": true
      },
      "label": "Вернуться на главную"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "text",
        "value": "163 Nguyễn Thiện Thuật",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "hover",
      "target": {
        "by": "text",
        "value": "163 Nguyễn Thiện Thuật",
        "exact": true
      },
      "pauseAfterMs": 8000,
      "narration": "The Cloud объединяет выбор атмосферы, бронирование, AI, связь с менеджером и навигацию — весь путь гостя в одном интерфейсе. Хотите такой же путь гостя для своего заведения? Свяжитесь с VIIVERSION."
    }
  ],
  "voice": {
    "locale": "ru-RU",
    "provider": "auto",
    "persona": "viiversion-presenter",
    "instructions": "Современная, тёплая, уверенная подача презентации продукта. Естественный русский язык, средний темп, короткие органичные паузы, без дикторской монотонности.",
    "requireNativeTimings": false,
    "pronunciation": {
      "The Cloud": "Зэ Клауд",
      "AI": "эй-ай",
      "Rooftop View": "руфтоп вью",
      "Sunset Line": "сансет лайн",
      "Shisha Lounge": "шиша лаунж",
      "Group VIP": "груп вип"
    }
  }
}
