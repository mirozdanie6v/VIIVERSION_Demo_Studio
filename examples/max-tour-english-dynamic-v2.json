  "steps": [
    {
      "action": "goto",
      "url": "/",
      "label": "Open MAX TOUR"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Choose a journey\"):visible, button:has-text(\"Choose a tour\"):visible, button:has-text(\"Выбрать путешествие\"):visible, button:has-text(\"Выбрать тур\"):visible"
      },
      "state": "visible",
      "timeoutMs": 20000
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Choose a journey\"):visible, button:has-text(\"Choose a tour\"):visible, button:has-text(\"Выбрать путешествие\"):visible, button:has-text(\"Выбрать тур\"):visible"
      },
      "pauseAfterMs": 4500,
      "label": "Focus first action"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Choose a journey\"):visible, button:has-text(\"Choose a tour\"):visible, button:has-text(\"Выбрать путешествие\"):visible, button:has-text(\"Выбрать тур\"):visible"
      },
      "label": "Open catalog"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": ".px-catalog-count, *:has-text(\"17 found\"), *:has-text(\"17 matching options\"), *:has-text(\"17 найдено\"), *:has-text(\"17 подходящих вариантов\")"
      },
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": ".px-catalog-count, *:has-text(\"17 found\"), *:has-text(\"17 matching options\"), *:has-text(\"17 найдено\"), *:has-text(\"17 подходящих вариантов\")"
      },
      "pauseAfterMs": 4200,
      "label": "Catalog value"
    },
    {
      "action": "scroll",
      "y": 420,
      "label": "Browse catalog",
      "pauseAfterMs": 500
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": ".px-site-tour-grid .px-site-tour-card:first-child, .px-tour-grid .px-tour-card:first-child"
      },
      "pauseAfterMs": 4200,
      "label": "Focus first recommended tour"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": ".px-site-tour-grid .px-site-tour-card:first-child, .px-tour-grid .px-tour-card:first-child"
      },
      "label": "Open recommended tour"
    },
    {
      "action": "wait",
      "ms": 5000,
      "label": "Tour details"
    },
    {
      "action": "scroll",
      "y": 500,
      "label": "Explore details",
      "pauseAfterMs": 500
    },
    {
      "action": "wait",
      "ms": 4400,
      "label": "Tour proof"
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Private\"):visible, button:has-text(\"Индивидуальный\"):visible, button:has-text(\"Индивидуально\"):visible"
      },
      "pauseAfterMs": 3000,
      "label": "Private option"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Private\"):visible, button:has-text(\"Индивидуальный\"):visible, button:has-text(\"Индивидуально\"):visible"
      },
      "label": "Choose private"
    },
    {
      "action": "wait",
      "ms": 4200,
      "label": "Booking path"
    },
    {
      "action": "scroll",
      "y": 420,
      "label": "Booking form",
      "pauseAfterMs": 500
    },
    {
      "action": "wait",
      "ms": 5200,
      "label": "Structured booking"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"AI Assistant\"):visible, button:has-text(\"ИИ-Помощник\"):visible"
      },
      "label": "Open AI assistant"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "input:visible, textarea:visible, [contenteditable=\"true\"]:visible"
      },
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "input:visible, textarea:visible, [contenteditable=\"true\"]:visible"
      },
      "value": "Which excursion would you recommend for a couple who wants nature, beautiful views, and a relaxed full-day trip? Please answer in English.",
      "pauseAfterMs": 2200,
      "label": "Ask for an excursion recommendation"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"→\"):visible"
      },
      "label": "Send AI question",
      "pauseAfterMs": 500
    },
    {
      "action": "wait",
      "ms": 9000,
      "label": "Show AI recommendation"
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "*:has-text(\"AI Consultant\"):visible, *:has-text(\"AI-консультант\"):visible"
      },
      "pauseAfterMs": 3200,
      "label": "AI proof"
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "button:has-text(\"AI Assistant\"):visible, button:has-text(\"ИИ-Помощник\"):visible"
      },
      "pauseAfterMs": 2200,
      "label": "Closing beat"
    }
  ]
}
