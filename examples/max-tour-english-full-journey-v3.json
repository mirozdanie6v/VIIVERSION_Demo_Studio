  "steps": [
    {
      "action": "goto",
      "url": "/",
      "label": "Home"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Choose a tour\"):visible, button:has-text(\"Choose a journey\"):visible"
      },
      "state": "visible",
      "timeoutMs": 20000
    },
    {
      "action": "wait",
      "ms": 1200,
      "label": "Establish home"
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Choose a tour\"):visible, button:has-text(\"Choose a journey\"):visible"
      },
      "pauseAfterMs": 900,
      "label": "Focus choose tour"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Choose a tour\"):visible, button:has-text(\"Choose a journey\"):visible"
      },
      "label": "Open catalog"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": ".px-site-tour-card:visible, .px-catalog-count:visible"
      },
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "wait",
      "ms": 1000,
      "label": "Establish catalog"
    },
    {
      "action": "scroll",
      "y": 300,
      "label": "Browse catalog",
      "pauseAfterMs": 350
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "article.px-site-tour-card:has-text(\"Dalat Premium\"):visible, article:has-text(\"Dalat Premium\"):visible"
      },
      "pauseAfterMs": 950,
      "label": "Focus Dalat Premium"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "article.px-site-tour-card:has-text(\"Dalat Premium\"):visible, article:has-text(\"Dalat Premium\"):visible"
      },
      "label": "Open Dalat Premium"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": ".px-detail-hero:visible, h1:has-text(\"Dalat Premium\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "wait",
      "ms": 1200,
      "label": "Establish tour"
    },
    {
      "action": "scroll",
      "y": 420,
      "label": "Explore tour details",
      "pauseAfterMs": 350
    },
    {
      "action": "wait",
      "ms": 1300,
      "label": "Read tour details"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"AI Assistant\"):visible, button:has-text(\"AI Consultant\"):visible"
      },
      "label": "Open AI consultant"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "textarea:visible, input[placeholder*=\"message\" i]:visible, input:visible, [contenteditable=\"true\"]:visible"
      },
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "textarea:visible, input[placeholder*=\"message\" i]:visible, input:visible, [contenteditable=\"true\"]:visible"
      },
      "value": "We're a couple looking for a relaxed full-day excursion with nature and beautiful views. What would you recommend for us? Please answer in English.",
      "pauseAfterMs": 700,
      "label": "Ask a human excursion question"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"→\"):visible, button:has-text(\"Send\"):visible"
      },
      "label": "Send AI question",
      "pauseAfterMs": 0
    },
    {
      "action": "waitForContentGrowth",
      "target": {
        "by": "css",
        "value": "body"
      },
      "minAddedChars": 90,
      "timeoutMs": 30000,
      "label": "Wait for actual AI answer"
    },
    {
      "action": "wait",
      "ms": 1800,
      "label": "Read AI answer"
    },
    {
      "action": "press",
      "key": "Escape",
      "label": "Close AI if modal"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": ".px-sticky-cta button:visible, button:has-text(\"Choose format\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": ".px-sticky-cta button:visible, button:has-text(\"Choose format\"):visible"
      },
      "pauseAfterMs": 750,
      "label": "Focus booking CTA"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": ".px-sticky-cta button:visible, button:has-text(\"Choose format\"):visible"
      },
      "label": "Start booking"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": ".px-commerce-flow:visible, .px-commerce-card:visible"
      },
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "wait",
      "ms": 900,
      "label": "Establish booking"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Continue with private tour\"):visible, button:has-text(\"Continue privately\"):visible"
      },
      "label": "Continue private"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Choose date\"):visible"
      },
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Choose date\"):visible"
      },
      "label": "Continue group size"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": ".px-date-grid button:visible, input[type=\"date\"]:visible"
      },
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": ".px-date-grid button:visible"
      },
      "label": "Select available date"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "label:has-text(\"Hotel\") input:visible, input[placeholder*=\"Amiana\" i]:visible"
      },
      "value": "Amiana Resort",
      "label": "Enter hotel"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Traveller details\"):visible"
      },
      "label": "Continue to traveller details"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "label:has-text(\"Your name\") input:visible"
      },
      "state": "visible",
      "timeoutMs": 10000
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "label:has-text(\"Your name\") input:visible"
      },
      "value": "Alex Morgan",
      "label": "Enter contact name"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "label:has-text(\"Phone\") input:visible"
      },
      "value": "+84 901 234 567",
      "label": "Enter phone"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "div.px-participant-v2 >> nth=0 >> input >> nth=0"
      },
      "value": "Alex Morgan",
      "label": "Traveller one name"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "div.px-participant-v2 >> nth=0 >> input >> nth=1"
      },
      "value": "1990-04-12",
      "label": "Traveller one birth date"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "div.px-participant-v2 >> nth=1 >> input >> nth=0"
      },
      "value": "Jamie Morgan",
      "label": "Traveller two name"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "div.px-participant-v2 >> nth=1 >> input >> nth=1"
      },
      "value": "1992-08-23",
      "label": "Traveller two birth date"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Get total price\"):visible"
      },
      "label": "Calculate total"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": ".px-quote-lines:visible"
      },
      "state": "visible",
      "timeoutMs": 15000
    },
    {
      "action": "wait",
      "ms": 1000,
      "label": "Show quote"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Bank card\"):visible"
      },
      "label": "Choose card"
    },
    {
      "action": "click",
      "target": {
