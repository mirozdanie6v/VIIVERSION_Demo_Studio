{
  "name": "MAX TOUR — Russian Premium Product Film v10",
  "baseUrl": "https://max-tour.viiversion.com",
  "viewport": {
    "width": 430,
    "height": 932
  },
  "defaultPauseMs": 220,
  "presentation": {
    "semanticCamera": {
      "enabled": true,
      "establishScale": 1,
      "focusScale": 1.1,
      "mobileFocusScale": 1.1,
      "maxCropRatio": 0.12,
      "safeAreaPx": 44,
      "focusTransitionMs": 240,
      "resolveTransitionMs": 300
    },
    "smartZoom": {
      "enabled": false
    },
    "cursor": {
      "enabled": false
    },
    "focusRing": {
      "enabled": true,
      "color": "rgba(255,166,92,0.28)",
      "width": 1,
      "padding": 5
    },
    "clickRipple": {
      "enabled": false
    },
    "tactilePress": {
      "enabled": true,
      "scale": 0.985,
      "durationMs": 190,
      "glowColor": "rgba(255,151,72,0.30)"
    }
  },
  "steps": [
    {
      "action": "goto",
      "url": "/",
      "label": "Home"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "role",
        "value": "button",
        "name": "RU",
        "exact": true
      },
      "state": "visible",
      "timeoutMs": 20000,
      "label": "Wait RU"
    },
    {
      "action": "click",
      "target": {
        "by": "role",
        "value": "button",
        "name": "RU",
        "exact": true
      },
      "pauseAfterMs": 450,
      "label": "Switch to Russian"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Выбрать тур\"):visible"
      },
      "state": "visible",
      "timeoutMs": 20000,
      "label": "Wait home hero"
    },
    {
      "action": "wait",
      "ms": 1200,
      "label": "Establish home"
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Выбрать тур\"):visible"
      },
      "pauseAfterMs": 900,
      "label": "Focus choose tour"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button.nav-btn:has-text(\"Каталог\"):visible"
      },
      "label": "Open catalog"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "h3:has-text(\"Далат «Премиум»\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait catalog"
    },
    {
      "action": "wait",
      "ms": 1000,
      "label": "Establish catalog"
    },
    {
      "action": "scroll",
      "y": 300,
      "label": "Browse catalog",
      "pauseAfterMs": 350
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "h3:has-text(\"Далат «Премиум»\"):visible"
      },
      "pauseAfterMs": 950,
      "label": "Focus Dalat Premium"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "h3:has-text(\"Далат «Премиум»\"):visible"
      },
      "label": "Open Dalat Premium"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": ".detail-hero:visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait tour"
    },
    {
      "action": "wait",
      "ms": 1200,
      "label": "Establish tour"
    },
    {
      "action": "scroll",
      "y": 420,
      "label": "Explore tour details",
      "pauseAfterMs": 350
    },
    {
      "action": "wait",
      "ms": 1300,
      "label": "Read tour details"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button.nav-btn:has-text(\"ИИ-Помощник\"):visible"
      },
      "label": "Open AI consultant"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": ".ai-consultant-input textarea:visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait AI input"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": ".ai-consultant-input textarea:visible"
      },
      "value": "Мы пара, живём в Нячанге и хотим красивую экскурсию без слишком тяжёлой программы. Подойдёт ли нам Далат «Премиум»? Ответь по-русски.",
      "pauseAfterMs": 700,
      "label": "Ask a human excursion question"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": ".ai-consultant-input button:visible >> nth=-1"
      },
      "label": "Send AI question",
      "pauseAfterMs": 0
    },
    {
      "action": "wait",
      "ms": 5000,
      "label": "Wait for actual AI answer"
    },
    {
      "action": "wait",
      "ms": 1800,
      "label": "Read AI answer"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button.nav-btn:has-text(\"Каталог\"):visible"
      },
      "pauseAfterMs": 450,
      "label": "Close AI consultant"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "h3:has-text(\"Далат «Премиум»\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Return to catalog"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "h3:has-text(\"Далат «Премиум»\"):visible"
      },
      "pauseAfterMs": 450,
      "label": "Return to Dalat"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": ".detail-hero:visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Return to tour"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Индивидуальный от $420\"):visible"
      },
      "pauseAfterMs": 400,
      "label": "Choose private format"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Забронировать\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait booking CTA"
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Забронировать\"):visible"
      },
      "pauseAfterMs": 750,
      "label": "Focus booking CTA"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Забронировать\"):visible"
      },
      "label": "Start booking"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Перейти к оплате\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait booking"
    },
    {
      "action": "wait",
      "ms": 900,
      "label": "Establish booking"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"−\"):visible >> nth=1"
      },
      "label": "Remove child"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "input[placeholder=\"Например: Sunrise\"]:visible"
      },
      "value": "Amiana Resort",
      "label": "Enter hotel"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "input[placeholder=\"Фамилия Имя\"]:visible >> nth=0"
      },
      "value": "Демо Гость Один",
      "label": "Traveller one name"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "input[type=\"date\"]:visible >> nth=1"
      },
      "value": "2000-01-01",
      "label": "Traveller one birth date"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "input[placeholder=\"Фамилия Имя\"]:visible >> nth=1"
      },
      "value": "Демо Гость Два",
      "label": "Traveller two name"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "input[type=\"date\"]:visible >> nth=2"
      },
      "value": "2001-01-01",
      "label": "Traveller two birth date"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"VNPAY\"):visible"
      },
      "label": "Choose VNPAY",
      "pauseAfterMs": 450
    },
    {
      "action": "wait",
      "ms": 1000,
      "label": "Show quote"
    }
  ]
}
