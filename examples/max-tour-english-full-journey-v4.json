{
  "name": "MAX TOUR — English Full Customer Journey v4",
  "baseUrl": "https://max-tour.viiversion.com",
  "viewport": {
    "width": 430,
    "height": 932
  },
  "defaultPauseMs": 220,
  "presentation": {
    "smartZoom": {
      "scale": 1.18,
      "mobileScale": 1.12,
      "transitionMs": 420,
      "settleMs": 120
    },
    "focusRing": {
      "enabled": true,
      "color": "rgba(255,255,255,0.40)",
      "width": 2,
      "padding": 7
    },
    "clickRipple": {
      "enabled": true,
      "color": "rgba(255,255,255,0.76)",
      "size": 58,
      "durationMs": 360
    },
    "localeOverlay": {
      "language": "en",
