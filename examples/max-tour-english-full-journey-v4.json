  },
  "steps": [
    {
      "action": "goto",
      "url": "/",
      "label": "Home"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Choose a tour\"):visible, button:has-text(\"Выбрать тур\"):visible"
      },
      "state": "visible",
      "timeoutMs": 20000,
      "label": "Wait home hero"
    },
    {
      "action": "wait",
      "ms": 1200,
      "label": "Establish home"
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Choose a tour\"):visible, button:has-text(\"Выбрать тур\"):visible"
      },
      "pauseAfterMs": 900,
      "label": "Focus choose tour"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Choose a tour\"):visible, button:has-text(\"Выбрать тур\"):visible"
      },
      "label": "Open catalog"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "h3:has-text(\"Dalat\"):visible, h3:has-text(\"Далат\"):visible, article:has-text(\"Dalat\"):visible, article:has-text(\"Далат\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait catalog"
    },
    {
      "action": "wait",
      "ms": 1000,
      "label": "Establish catalog"
    },
    {
      "action": "scroll",
      "y": 300,
      "label": "Browse catalog",
      "pauseAfterMs": 350
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "h3:has-text(\"Dalat\"):visible, h3:has-text(\"Далат\"):visible"
      },
      "pauseAfterMs": 950,
      "label": "Focus Dalat Premium"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "h3:has-text(\"Dalat\"):visible, h3:has-text(\"Далат\"):visible"
      },
      "label": "Open Dalat Premium"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "button:has-text(\"AI Assistant\"):visible, button:has-text(\"AI Consultant\"):visible, button:has-text(\"ИИ-Помощник\"):visible, button:has-text(\"Choose format\"):visible, button:has-text(\"Выбрать формат\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait tour"
    },
    {
      "action": "wait",
      "ms": 1200,
      "label": "Establish tour"
    },
    {
      "action": "scroll",
      "y": 420,
      "label": "Explore tour details",
      "pauseAfterMs": 350
    },
    {
      "action": "wait",
      "ms": 1300,
      "label": "Read tour details"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"AI Assistant\"):visible, button:has-text(\"AI Consultant\"):visible, button:has-text(\"ИИ-Помощник\"):visible"
      },
      "label": "Open AI consultant"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "textarea:visible, input[placeholder*=\"message\" i]:visible, input:visible, [contenteditable=\"true\"]:visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait AI input"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "textarea:visible, input[placeholder*=\"message\" i]:visible, input:visible, [contenteditable=\"true\"]:visible"
      },
      "value": "We're a couple looking for a relaxed full-day excursion with nature and beautiful views. What would you recommend for us? Please answer in English.",
      "pauseAfterMs": 700,
      "label": "Ask a human excursion question"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"→\"):visible, button:has-text(\"Send\"):visible, button:has-text(\"Отправить\"):visible"
      },
      "label": "Send AI question",
      "pauseAfterMs": 0
    },
    {
      "action": "waitForContentGrowth",
      "target": {
        "by": "css",
        "value": "body"
      },
      "minAddedChars": 90,
      "timeoutMs": 30000,
      "label": "Wait for actual AI answer"
    },
    {
      "action": "wait",
      "ms": 1800,
      "label": "Read AI answer"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Catalog\"):visible, a:has-text(\"Catalog\"):visible, button:has-text(\"Каталог\"):visible, a:has-text(\"Каталог\"):visible"
      },
      "label": "Return to catalog after AI"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "h3:has-text(\"Dalat\"):visible, h3:has-text(\"Далат\"):visible, article:has-text(\"Dalat\"):visible, article:has-text(\"Далат\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait catalog after AI"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "h3:has-text(\"Dalat\"):visible, h3:has-text(\"Далат\"):visible"
      },
      "label": "Reopen Dalat after AI"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Private\"):visible, button:has-text(\"Индивидуальный\"):visible, button:has-text(\"Индивидуально\"):visible, button:has-text(\"Choose format\"):visible, button:has-text(\"Выбрать формат\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait tour after AI"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Private\"):visible, button:has-text(\"Индивидуальный\"):visible, button:has-text(\"Индивидуально\"):visible, button:has-text(\"Choose format\"):visible, button:has-text(\"Выбрать формат\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait booking CTA"
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Private\"):visible, button:has-text(\"Индивидуальный\"):visible, button:has-text(\"Индивидуально\"):visible, button:has-text(\"Choose format\"):visible, button:has-text(\"Выбрать формат\"):visible"
      },
      "pauseAfterMs": 750,
      "label": "Focus booking CTA"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Private\"):visible, button:has-text(\"Индивидуальный\"):visible, button:has-text(\"Индивидуально\"):visible, button:has-text(\"Choose format\"):visible, button:has-text(\"Выбрать формат\"):visible"
      },
      "label": "Start booking"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "*:has-text(\"What would you like to book?\"):visible, *:has-text(\"Что хотите забронировать?\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait booking"
    },
    {
      "action": "wait",
      "ms": 900,
      "label": "Establish booking"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Continue with private tour\"):visible, button:has-text(\"Продолжить индивидуально\"):visible"
      },
      "label": "Continue private"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "*:has-text(\"Who is travelling?\"):visible, *:has-text(\"Кто едет?\"):visible"
      },
      "state": "visible",
      "timeoutMs": 10000,
      "label": "Wait group size"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Choose date\"):visible, button:has-text(\"Выбрать дату\"):visible"
      },
      "label": "Continue group size"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "*:has-text(\"When are we going?\"):visible, *:has-text(\"Когда едем?\"):visible, input[type=\"date\"]:visible"
      },
      "state": "visible",
      "timeoutMs": 10000,
      "label": "Wait date"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": ".px-date-grid button:visible"
      },
      "label": "Select available date"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "input[placeholder*=\"Amiana\" i]:visible, label:has-text(\"Hotel\") input:visible, label:has-text(\"Отель\") input:visible"
      },
      "value": "Amiana Resort",
      "label": "Enter hotel"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": ".px-commerce-card button.px-button-primary:visible, .px-commerce-card button.px-block:visible"
      },
      "label": "Continue to traveller details"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": ".px-participant-v2:visible"
      },
      "state": "visible",
      "timeoutMs": 10000,
      "label": "Wait traveller details"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "label:has-text(\"Your name\") input:visible, label:has-text(\"Ваше имя\") input:visible"
      },
      "value": "Demo Guest",
      "label": "Enter contact name"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "label:has-text(\"Phone\") input:visible, label:has-text(\"Телефон\") input:visible"
      },
      "value": "0000000000",
      "label": "Enter phone"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "div.px-participant-v2 >> nth=0 >> input >> nth=0"
      },
      "value": "Demo Guest One",
      "label": "Traveller one name"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "div.px-participant-v2 >> nth=0 >> input >> nth=1"
      },
      "value": "2000-01-01",
      "label": "Traveller one birth date"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "div.px-participant-v2 >> nth=1 >> input >> nth=0"
      },
      "value": "Demo Guest Two",
      "label": "Traveller two name"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "div.px-participant-v2 >> nth=1 >> input >> nth=1"
      },
      "value": "2001-01-01",
      "label": "Traveller two birth date"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": ".px-commerce-card button.px-button-primary:visible, .px-commerce-card button.px-block:visible"
      },
      "label": "Calculate total"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": ".px-quote-lines:visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait quote"
    },
    {
      "action": "wait",
      "ms": 1000,
      "label": "Show quote"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Bank card\"):visible, button:has-text(\"Банковская карта\"):visible"
      },
      "label": "Choose card"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"MAX TOUR payment\"):visible, button:has-text(\"Оплата MAX TOUR\"):visible"
      },
      "label": "Create booking"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": ".px-order-created:visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait order created"
    },
    {
      "action": "wait",
      "ms": 850,
      "label": "Booking created"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"DEMO\"):visible"
      },
      "label": "Demo payment"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": ".px-commerce-success:visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait booking confirmation"
    },
    {
      "action": "wait",
      "ms": 1600,
      "label": "Booking confirmation"
    }
  ]
}
