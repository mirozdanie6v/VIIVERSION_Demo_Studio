  "steps": [
    {
      "action": "goto",
      "url": "/",
      "label": "Home"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Choose a tour\"):visible, button:has-text(\"Выбрать тур\"):visible"
      },
      "state": "visible",
      "timeoutMs": 20000,
      "label": "Wait home hero"
    },
    {
      "action": "wait",
      "ms": 1200,
      "label": "Establish home"
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Choose a tour\"):visible, button:has-text(\"Выбрать тур\"):visible"
      },
      "pauseAfterMs": 900,
      "label": "Focus choose tour"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Choose a tour\"):visible, button:has-text(\"Выбрать тур\"):visible"
      },
      "label": "Open catalog"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "h3:has-text(\"Dalat\"):visible, h3:has-text(\"Далат\"):visible, article:has-text(\"Dalat\"):visible, article:has-text(\"Далат\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait catalog"
    },
    {
      "action": "wait",
      "ms": 1000,
      "label": "Establish catalog"
    },
    {
      "action": "scroll",
      "y": 300,
      "label": "Browse catalog",
      "pauseAfterMs": 350
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "h3:has-text(\"Dalat\"):visible, h3:has-text(\"Далат\"):visible"
      },
      "pauseAfterMs": 950,
      "label": "Focus Dalat Premium"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "h3:has-text(\"Dalat\"):visible, h3:has-text(\"Далат\"):visible"
      },
      "label": "Open Dalat Premium"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "button:has-text(\"AI Assistant\"):visible, button:has-text(\"AI Consultant\"):visible, button:has-text(\"ИИ-Помощник\"):visible, button:has-text(\"Choose format\"):visible, button:has-text(\"Выбрать формат\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait tour"
    },
    {
      "action": "wait",
      "ms": 1200,
      "label": "Establish tour"
    },
    {
      "action": "scroll",
      "y": 420,
      "label": "Explore tour details",
      "pauseAfterMs": 350
    },
    {
      "action": "wait",
      "ms": 1300,
      "label": "Read tour details"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"AI Assistant\"):visible, button:has-text(\"AI Consultant\"):visible, button:has-text(\"ИИ-Помощник\"):visible"
      },
      "label": "Open AI consultant"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "textarea:visible, input[placeholder*=\"message\" i]:visible, input:visible, [contenteditable=\"true\"]:visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait AI input"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "textarea:visible, input[placeholder*=\"message\" i]:visible, input:visible, [contenteditable=\"true\"]:visible"
      },
      "value": "We're a couple looking for a relaxed full-day excursion with nature and beautiful views. What would you recommend for us? Please answer in English.",
      "pauseAfterMs": 700,
      "label": "Ask a human excursion question"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"→\"):visible, button:has-text(\"Send\"):visible, button:has-text(\"Отправить\"):visible"
      },
      "label": "Send AI question",
      "pauseAfterMs": 0
    },
    {
      "action": "waitForContentGrowth",
      "target": {
        "by": "css",
        "value": "body"
      },
      "minAddedChars": 90,
      "timeoutMs": 30000,
      "label": "Wait for actual AI answer"
    },
    {
      "action": "wait",
      "ms": 1800,
      "label": "Read AI answer"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Catalog\"):visible, a:has-text(\"Catalog\"):visible, button:has-text(\"Каталог\"):visible, a:has-text(\"Каталог\"):visible"
      },
      "label": "Return to catalog after AI"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "h3:has-text(\"Dalat\"):visible, h3:has-text(\"Далат\"):visible, article:has-text(\"Dalat\"):visible, article:has-text(\"Далат\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait catalog after AI"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "h3:has-text(\"Dalat\"):visible, h3:has-text(\"Далат\"):visible"
      },
      "label": "Reopen Dalat after AI"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Private\"):visible, button:has-text(\"Индивидуальный\"):visible, button:has-text(\"Индивидуально\"):visible, button:has-text(\"Choose format\"):visible, button:has-text(\"Выбрать формат\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait tour after AI"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Private\"):visible, button:has-text(\"Индивидуальный\"):visible, button:has-text(\"Индивидуально\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait booking CTA"
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Private\"):visible, button:has-text(\"Индивидуальный\"):visible, button:has-text(\"Индивидуально\"):visible"
      },
      "pauseAfterMs": 650,
      "label": "Focus booking CTA"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "button:has-text(\"Private\"):visible, button:has-text(\"Индивидуальный\"):visible, button:has-text(\"Индивидуально\"):visible"
      },
      "label": "Choose private format"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "#tourScreen button.primary.wide-primary:visible, #tourScreen button:has-text(\"Book now\"):visible, #tourScreen button:has-text(\"Забронировать\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait private booking action"
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "#tourScreen button.primary.wide-primary:visible, #tourScreen button:has-text(\"Book now\"):visible, #tourScreen button:has-text(\"Забронировать\"):visible"
      },
      "pauseAfterMs": 650,
      "label": "Focus private booking action"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "#tourScreen button.primary.wide-primary:visible, #tourScreen button:has-text(\"Book now\"):visible, #tourScreen button:has-text(\"Забронировать\"):visible"
      },
      "label": "Start booking"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "#bookingScreen.active:visible, #bookingScreen h2:has-text(\"Booking\"):visible, #bookingScreen h2:has-text(\"Оформление поездки\"):visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait booking"
    },
    {
      "action": "wait",
      "ms": 800,
      "label": "Establish booking"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "#bookingScreen input[type=\"date\"]:visible"
      },
      "value": "2026-10-20",
      "label": "Select available date"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "#bookingScreen input[placeholder*=\"Sunrise\" i]:visible"
      },
      "value": "Amiana Resort",
      "label": "Enter hotel"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "#bookingScreen .traveler-card >> nth=0 >> input >> nth=0"
      },
      "value": "Demo Guest One",
      "label": "Traveller one name"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "#bookingScreen .traveler-card >> nth=0 >> input >> nth=1"
      },
      "value": "1990-01-01",
      "label": "Traveller one birth date"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "#bookingScreen .traveler-card >> nth=1 >> input >> nth=0"
      },
      "value": "Demo Guest Two",
      "label": "Traveller two name"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "#bookingScreen .traveler-card >> nth=1 >> input >> nth=1"
      },
      "value": "1992-02-02",
      "label": "Traveller two birth date"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "#bookingScreen .traveler-card >> nth=2 >> input >> nth=0"
      },
      "value": "Demo Guest Three",
      "label": "Traveller three name"
    },
    {
      "action": "fill",
      "target": {
        "by": "css",
        "value": "#bookingScreen .traveler-card >> nth=2 >> input >> nth=1"
      },
      "value": "2016-03-03",
      "label": "Traveller three birth date"
    },
    {
      "action": "hover",
      "target": {
        "by": "css",
        "value": "#bookingScreen .price-facts:visible"
      },
      "pauseAfterMs": 700,
      "label": "Calculate total"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "#bookingScreen button:has-text(\"VNPAY\"):visible"
      },
      "label": "Choose card"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "#bookingScreen button:has-text(\"Continue to payment\"):visible, #bookingScreen button:has-text(\"Перейти к оплате\"):visible"
      },
      "label": "Create booking"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "#bookingScreen .qrbox:visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait order created"
    },
    {
      "action": "wait",
      "ms": 850,
      "label": "Booking created"
    },
    {
      "action": "click",
      "target": {
        "by": "css",
        "value": "#bookingScreen button:has-text(\"Payment completed\"):visible, #bookingScreen button:has-text(\"Оплата выполнена\"):visible"
      },
      "label": "Demo payment"
    },
    {
      "action": "waitFor",
      "target": {
        "by": "css",
        "value": "#tripsScreen.active .trip-card:visible, #tripsScreen .trip-card:visible"
      },
      "state": "visible",
      "timeoutMs": 15000,
      "label": "Wait booking confirmation"
    },
    {
      "action": "wait",
      "ms": 1600,
      "label": "Booking confirmation"
    }
  ]
}
