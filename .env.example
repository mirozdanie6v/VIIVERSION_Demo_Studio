OPENAI_API_KEY=
OPENAI_DIRECTOR_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

DEMO_STUDIO_API_KEY=
DEMO_STUDIO_ALLOW_UNAUTHENTICATED=false

PUBLIC_BASE_URL=https://demostudio.viiversion.com
HOST=0.0.0.0
PORT=8787

# Optional explicit API/MCP Host and browser Origin allowlists.
DEMO_STUDIO_ALLOWED_API_HOSTS=
DEMO_STUDIO_ALLOWED_ORIGINS=

DEMO_STUDIO_MAX_CONCURRENT_JOBS=2
DEMO_STUDIO_DAILY_JOB_LIMIT=50
DEMO_STUDIO_STORAGE_ROOT=.demo-studio-data/jobs
# Optional bounded network-idle settle after DOMContentLoaded. Explicit scenario waits are unchanged.
DEMO_STUDIO_NAVIGATION_SETTLE_MS=1500
# Set false for an immediate runtime fallback to serial capture then voiceover.
DEMO_STUDIO_PARALLEL_VOICEOVER=true
# Reuse UX/design audit results for repeated jobs of the same URL. Set 0 to disable.
DEMO_STUDIO_UX_CACHE_TTL_MS=600000
# Reuse one headless Chromium process with isolated BrowserContexts. Set false to disable.
DEMO_STUDIO_REUSE_BROWSER=true
# Measured default: veryfast. Set fast for immediate encoder-quality rollback.
DEMO_STUDIO_FFMPEG_PRESET=veryfast
# Validated production default after the full MAX TOUR gate.
# Set false for an immediate new-job rollback to the standard capture/render path.
DEMO_STUDIO_PRODUCTION_HYBRID=true
# Low-level CLI/benchmark opt-ins. The production Job Manager uses the flag above.
DEMO_STUDIO_HYBRID_CAPTURE=false
DEMO_STUDIO_HYBRID_RENDER=false
# When true, hybrid artifact/composition errors fail instead of using the existing source.
# Production intentionally keeps this false so a composition problem can still return a video.
DEMO_STUDIO_HYBRID_RENDER_STRICT=false

# Optional billing/analytics receiver for completed and failed usage events.
DEMO_STUDIO_USAGE_WEBHOOK_URL=
DEMO_STUDIO_USAGE_WEBHOOK_TOKEN=

# Optional comma-separated hostname allowlist for target web applications.
DEMO_STUDIO_ALLOWED_HOSTS=

# Development / deterministic CI only. Keep false in production.
ALLOW_PRIVATE_TARGETS=false
